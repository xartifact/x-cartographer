
# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=X-Cartographer
NEXT_PUBLIC_APP_VERSION=1.0.0

# 功能开关
NEXT_PUBLIC_ENABLE_COLLABORATION=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# 日志级别（trace / debug / info / warn / error / fatal / silent）
# 开发环境默认 debug，生产环境默认 info
NEXT_PUBLIC_LOG_LEVEL=debug

# 存储配置
NEXT_PUBLIC_MAX_PROJECTS=50
NEXT_PUBLIC_MAX_STORIES_PER_PROJECT=500

# 数据库配置（生产环境使用 PostgreSQL）
DATABASE_URL=postgresql://user:password@localhost:5432/x-cartographer
