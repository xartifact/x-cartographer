# LLM API 配置
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=X-Product-Roadmap
NEXT_PUBLIC_APP_VERSION=1.0.0

# LLM 默认配置
NEXT_PUBLIC_DEFAULT_LLM_PROVIDER=openai
NEXT_PUBLIC_DEFAULT_MODEL=gpt-4-turbo-preview

# 加密密钥（生成随机字符串）
NEXT_PUBLIC_ENCRYPTION_KEY=your-secret-key-here

# 功能开关
NEXT_PUBLIC_ENABLE_COLLABORATION=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# 存储配置
NEXT_PUBLIC_MAX_PROJECTS=50
NEXT_PUBLIC_MAX_STORIES_PER_PROJECT=500

# 数据库配置（生产环境使用 PostgreSQL）
DATABASE_URL=postgresql://user:password@localhost:5432/x-product-roadmap
