{
  "name": "x-cartographer",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "lint": "oxlint",
    "format": "oxfmt",
    "type-check": "bun run --cwd apps/web type-check",
    "test": "bun test apps/server/src/__tests__/ apps/cli/src/__tests__/"
  },
  "devDependencies": {
    "oxlint": "^1.70.0",
    "oxfmt": "^0.55.0",
    "lint-staged": "^15.2.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "fast-uri": "^4.1.3",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.23",
    "dompurify": "^3.4.13",
    "nanoid@^3": "^3.3.19",
    "esbuild@0.18": "^0.25.12"
  }
}
