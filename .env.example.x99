# x-cartographer 部署环境变量（外部 PostgreSQL）
# 复制为 .env 后按需修改（x99 上的路径：~/Docker/x-cartographer/.env）

# 服务端口（主机映射）
HOST_PORT=8787

# 外部 PostgreSQL 连接（复用 x99 共享 postgresql 实例）
# 已创建数据库：x_cartographer
DB_HOST=100.80.110.125
DB_PORT=5432
DB_NAME=x_cartographer
DB_USER=example
DB_PASSWORD=example

# 前端 API 地址（可选；留空 = 同源，由 gateway 托管 / 代理 /api）
# VITE_API_URL=